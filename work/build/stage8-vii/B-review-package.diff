+        OmittedLine(line_no=5, text="Inventories                        n/m             300"),
+        OmittedLine(line_no=6, text="Total assets 9,100 8,900"),
+    )
+
+
+def test_d1_clean_page_and_lone_page_number_omit_nothing() -> None:
+    clean = "\n".join(
+        [
+            "ASSETS",
+            "June 30, 2026 | December 31, 2025",
+            "Cash | 1 | 2",
+            "NOTES",
+            "June 30, 2026 | December 31, 2025",
