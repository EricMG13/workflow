  "max_line_raw_bytes_including_LF": 4194304,
  "single_read_limit_raw_bytes": 4194305,
  "max_messages_unchanged": 2048,
  "accepted_setup": {
    "reader": "fresh unused io.TextIOWrapper with open readable binary .buffer",
    "writer": "fresh unused io.TextIOWrapper with open writable binary .buffer",
    "buffer_only": true,
    "wrapper_text_encoding_errors_newline": "Irrelevant because wrapper text read/write methods are never used",
    "freshness": "Trusted setup precondition; no claim that decoder history can be inferred from public TextIO state",
    "setup_refusals": "StringIO/nonbuffer/non-TextIOWrapper/closed or wrong-direction streams -> bad_arguments before consumption/product or audit mutation"
  },
  "framing": {
    "complete_frame": "ends LF and raw byte length <=MAX_LINE, including LF and optional preceding CR",
    "decode": "bytes.decode UTF8 strict, then JSON finite/shape checks; raw bytes are never reconstructed from text",
    "retention": "exact consumed bytes under payload SHA plus TransportMessage(index,operation,request_sha256) before product dispatch",
    "recognized_operation": "Existing exact operation keys and valid argument types; malformed/nonUTF8/extra keys -> invalid; unknown operation -> invalid/not_permitted",
    "empty_eof": "No TransportMessage, no refusal frame, no successful close",
    "partial_eof": "Retain exact nonempty observed bytes, invalid/bad_arguments, emit refusal if output succeeds, stop",
    "oversize": "Exactly MAX_LINE+1 consumed bytes; retain exact prefix, invalid/transport_limit, emit refusal if output succeeds and stop WITHOUT draining unread suffix; no whole-line-retention claim",
    "invalid_complete_frame": "Retain invalid and refuse; may continue to next raw frame within durable budget",
    "budget": "If durable MAX_MESSAGES already consumed, existing transport_limit before another input read/record; do not append message2049 or reset on reopen",
    "read_bound_scope": "At most MAX_LINE+1 bytes returned/consumed by the binary buffer call; internal buffered prefetch is unread input, not handled frames."
  },
