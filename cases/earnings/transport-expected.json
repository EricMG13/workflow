  "scope": "Same B1 state/transport review continuation; immutable early setup authority and raw byte framing/audit clarification only; no new financial answers/product acceptance",
  "authority": "LEAD explicit rulings preserve public TextIO/owner-prefix signatures and source/owner oracles; add strict OwnerSetup and AuditEntry setup kind only; buffer-only binary framing",
  "original_pins": {
    "owner_lease_sha256": "e66aa2df765ff76c2fe9644ba2f5c003dc65572ad6060246538265171bc54071",
