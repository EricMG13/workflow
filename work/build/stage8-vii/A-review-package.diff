--- /dev/null
+++ b/tests/test_report_view_tl10_4.py
@@ -0,0 +1,16 @@
+"""H03: CP-L10 TL10.4 `decision_impact` is stored with the analyst's `{TL10.2...}` reference
+tokens (it reuses TL10.3 `credit_transmission`, which `cpl10._text_issues` validates), so the
+report view resolves it like TL10.3 and shows the figure, never the raw token."""
+
+from test_connect_cpl10 import _tl10_3_facts, _tl10_3_page
+
+
+def test_tl10_4_decision_impact_shows_the_figure_not_the_reference() -> None:
+    _, topic, facts = _tl10_3_facts()
+    page = _tl10_3_page(facts)
+    transmission = page[f"TL10.3.{topic}.credit_transmission"]
+    impact = page[f"TL10.4.{topic}.decision_impact"]
+    for key in ("display", "table_display"):
+        assert "{" not in impact[key]
+        assert "3.75 US$ m" in impact[key]
+        assert impact[key] == transmission[key]
diff --git a/tests/test_source_context_blank.py b/tests/test_source_context_blank.py
index 611841b8..6d890e4e 100644
--- a/tests/test_source_context_blank.py
+++ b/tests/test_source_context_blank.py
@@ -135,10 +135,39 @@ def test_frozen_cp1_submissions_hold_no_blank_limitation() -> None:
     """Parity: with no blank limitation in any frozen submission, the new rule adds no issue."""
     seen = 0
     for path in sorted((ROOT / "cases").rglob("submissions.json")):
         for review in _reviews(json.loads(path.read_text())):
             seen += 1
             blanks = [text for text in _limitations(review) if is_blank(text)]
             assert blanks == [], path
             explanations = [s.get("event_scan_explanation", "x") for s in review["sources"]]
             assert not any(is_blank(text) for text in explanations), path
     assert seen > 0
+
+
+@pytest.mark.parametrize("field", ("accounting_basis", "entity_perimeter"))
+@pytest.mark.parametrize("blank", (" ", "​"))
+def test_blank_scope_dimension_is_lacking(field: str, blank: str) -> None:
+    """H09: a blank `accounting_basis` or `entity_perimeter` on a financial historical scope is
+    rule 1's issue, as a null is; it must not pass and settle facts `publish_model` then refuses."""
+    doc = copy.deepcopy(CONTEXT)
+    scope = doc["sources"][1]["scopes"][0]
+    assert scope["period_kind"] in ("historical_duration", "period_end")
+    scope[field] = blank
+    assert _issues(doc) == (f"Financial scope lacks {field}: {scope['scope_id']}",)
+
+
+def test_blank_dimension_beside_stated_sibling_is_lacking_not_disagreement() -> None:
+    """H09: a blank is rule 1's issue alone; rule 2 must not count it as a second stated value."""
+    doc = copy.deepcopy(CONTEXT)
+    scopes = doc["sources"][1]["scopes"]
+    assert len(scopes) > 1
+    assert all(s["accounting_basis"] == "IFRS" for s in scopes)
+    scopes[0]["accounting_basis"] = "​"
+    assert _issues(doc) == (f"Financial scope lacks accounting_basis: {scopes[0]['scope_id']}",)
+
+
+def test_visible_scope_dimensions_give_no_issue() -> None:
+    doc = copy.deepcopy(CONTEXT)
+    scope = doc["sources"][1]["scopes"][0]
+    assert (scope["accounting_basis"], scope["entity_perimeter"]) == ("IFRS", "consolidated group")
+    assert _issues(doc) == ()
